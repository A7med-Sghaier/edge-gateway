# ─────────────────────────────────────────────────────────────────────────────
# edge-gateway configuration
# Copy to `.env`, fill in, then:  docker compose up -d
# ─────────────────────────────────────────────────────────────────────────────

# Email used for Let's Encrypt registration / expiry notices.
ACME_EMAIL=admin@example.com

# ── Optional Traefik dashboard ───────────────────────────────────────────────
# Leave DASHBOARD_HOST empty to disable. Generate DASHBOARD_AUTH with:
#   htpasswd -nb admin 'your-password'
# In this file, DO NOT escape the $ signs (values are read literally).
DASHBOARD_HOST=
DASHBOARD_AUTH=

# ── Routes (file provider) ───────────────────────────────────────────────────
# ROUTE_* is ONLY for apps that do NOT carry their own Traefik labels.
#
# Apps that already ship Traefik labels are discovered automatically by the
# Docker provider — do NOT add them here. In particular a multi-tenant app that
# already ships Traefik labels needs NO ROUTE_* entry: its tenant containers
# attach to a shared network (e.g. `app-traffic`) with per-tenant routing/middleware
# labels and the edge picks them up on its own. See README "How a labelled
# multi-tenant app plugs in".
#
# One block per label-less app. Number them 1,2,3,... contiguously (a gap stops
# parsing).
#
#   ROUTE_N_NAME         unique id (also the Traefik router/service name)
#   ROUTE_N_HOSTS        comma-separated hostnames for this app
#   ROUTE_N_SERVICE      backend url — container on the `web` network, or external
#   ROUTE_N_TLS          optional, default true (HTTPS + auto cert)
#   ROUTE_N_ENTRYPOINTS  optional, default websecure

# Example: a plain Docker app on the `web` network with no Traefik labels
ROUTE_1_NAME=dashboard
ROUTE_1_HOSTS=dash.example.com
ROUTE_1_SERVICE=http://dashboard-app:8080

# Example: an app that lives outside Docker / on another host
# ROUTE_2_NAME=legacy
# ROUTE_2_HOSTS=legacy.example.com
# ROUTE_2_SERVICE=http://10.0.0.42:9000
