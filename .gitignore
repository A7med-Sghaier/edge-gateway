# Secrets & per-server config. The pattern is `.env*`, NOT `.env.*` — the
# dot-anchored form misses editor/Finder duplicates like `.env copy`, which
# carry exactly the same secrets.
.env*
!.env.example

# Local compose overlays (app-specific data-plane network, alt ports, etc.)
# Covers docker-compose.override.yml AND named examples like
# docker-compose.dev.override.yml — never commit app-specific overlays.
docker-compose*.override.yml

# Let's Encrypt certificate store
letsencrypt/

# Generated dynamic config (rendered from .env at runtime)
traefik/dynamic/*.yml
traefik/dynamic/*.yaml

# Generated edge-spa nginx config (rendered from APP_* in .env at runtime) —
# server-local, mounted into the edge-spa container. Never committed.
nginx/generated/

# Private, host-specific deployment runbooks (kept out of the public repo)
*.local.md

# Local tool state — records real paths on this machine
.claude/settings.local.json

.idea/
# Locally issued dev certificates (mkcert) — private keys, never committed
certs/
