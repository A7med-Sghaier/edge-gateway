# Secrets & per-server config
.env

# Local compose overlays (app-specific data-plane network, alt ports, etc.)
# Covers docker-compose.override.yml AND named examples like
# docker-compose.dev.override.yml — never commit app-specific overlays.
docker-compose*.override.yml

# Let's Encrypt certificate store
letsencrypt/

# Generated dynamic config (rendered from .env at runtime)
traefik/dynamic/*.yml
traefik/dynamic/*.yaml

# Server-only host nginx SPA configs — live in $DEPLOY_DIR/nginx on the box
# (and get symlinked/copied into /etc/nginx). Never committed to the public repo.
nginx/*.conf

# Private, app-specific deployment runbooks (kept out of the public repo)
*.local.md
DEPLOY-*.local.md

.idea/